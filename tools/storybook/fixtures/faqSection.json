    {
      "_key": "when-where",
      "answer": [
        {
          "_key": "when-wherea0",
          "_type": "block",
          "children": [
            {
              "_key": "when-wherea0s",
              "_type": "span",
              "marks": [],
              "text": "Friday 12 to Sunday 14 February 2027, at The Lodge Jamberoo, 406 Jamberoo Mountain Rd, Jamberoo NSW. It is about 90 minutes south of Sydney."
            }
          ],
          "markDefs": [],
          "style": "normal"
        }
      ],
      "note": null,
      "question": "When and where is it?"
    },
    {
      "_key": "check-in",
      "answer": [
        {
          "_key": "check-ina0",
          "_type": "block",
          "children": [
            {
              "_key": "check-ina0s",
              "_type": "span",
              "marks": [],
              "text": "Check in begins after 3pm on Friday, then join us for dinner that evening. We finish with a recovery breakfast at Lulu’s on Sunday before check-out at 10am."
            }
          ],
          "markDefs": [],
          "style": "normal"
        },
        {
          "_key": "check-ina1",
          "_type": "block",
          "children": [
            {
              "_key": "check-ina1s",
              "_type": "span",
              "marks": [],
              "text": "For those who want to keep the party going poolside on Sunday, there is the option to book another night. "
            }
          ],
          "markDefs": [],
          "style": "normal"
        }
      ],
      "note": "3pm Friday · 10am Sunday",
      "question": "When do I arrive and leave?"
    },
    {
      "_key": "stay",
      "answer": [
        {
          "_key": "staya0",
          "_type": "block",
          "children": [
            {
              "_key": "staya0s",
              "_type": "span",
              "marks": [],
              "text": "Everyone stays on site. The Lodge has 39 rooms, and we have booked them for the whole weekend so no one has to sort out accommodation."
            }
          ],
          "markDefs": [],
          "style": "normal"
        },
        {
          "_key": "staya1",
          "_type": "block",
          "children": [
            {
              "_key": "staya1s",
              "_type": "span",
              "marks": [],
              "text": "There are King Rooms, Twin Doubles and Family Rooms. The Stay page has the details of each."
            }
          ],
          "markDefs": [],
          "style": "normal"
        }
      ],
      "note": null,
      "question": "Where are we staying?"
    },
    {
      "_key": "contribution",
      "answer": [
        {
          "_key": "contributiona0",
          "_type": "block",
          "children": [
            {
              "_key": "contributiona0s",
              "_type": "span",
              "marks": [],
              "text": "We’ve reserved all the rooms so everyone can stay onsite together. We’ll confirm the room type once we’ve received your RSVP confirmation, and ask that guests pay us directly based on their room type, dates, and occupancy.\n\nAustralian guests: Bank transfer"
            }
          ],
          "markDefs": [],
          "style": "normal"
        },
