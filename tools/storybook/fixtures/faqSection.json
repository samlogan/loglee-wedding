      "answer": [
        {
          "_key": "k75",
          "_type": "block",
          "children": [
            {
              "_key": "k76",
              "_type": "span",
              "marks": [],
              "text": "For those travelling, your presence is the greatest gift of all. We know Australia is a million miles away, and appreciate you spending the entire weekend with us. "
            }
          ],
