              "marks": [],
              "text": "Please RSVP by 11 December 2026 on the RSVP page. It also asks for dietary requirements, your kids’ ages and a song request, so it is the one place to tell us everything."
            }
          ],
          "markDefs": [],
          "style": "normal"
